# Public URL of the deployed backend API (no trailing slash).
# On Vercel, set this in Project Settings -> Environment Variables.
# Example: https://zega-alert-api.onrender.com
VITE_API_URL=

# Google Maps JavaScript API key (spec §4.4). Used by the live SOS/officer map
# and the geofence editor. Enable "Maps JavaScript API" on the key.
VITE_GOOGLE_MAPS_API_KEY=
