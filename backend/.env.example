DATABASE_URL=postgres://zega:zega_dev_2026@localhost:5432/zega_alert
PORT=5000
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
APP_NAME=ZEGA-ALERT
PUBLIC_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Encryption at rest (AES-256-GCM) ---
# 64 hex chars (32 bytes) or any passphrase (hashed to 32 bytes).
# Used to encrypt selected PII columns (missing person contact_phone, SOS address_text).
ENCRYPTION_KEY=

# --- Africa's Talking SMS (set for production, dev mode logs instead) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Supabase (optional hosted Postgres). Takes precedence over DATABASE_URL. ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# --- Firebase (optional). Enables Firestore mirror, Cloud Storage uploads and FCM push. ---
# Paste the service-account JSON (single line) or a path to the .json file.
# On hosts that inject env vars, use FIREBASE_SERVICE_ACCOUNT_JSON with the raw JSON.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=
FCM_PROJECT_ID=

# --- Translation engine (LibreTranslate-compatible). Blank = placeholder mode. ---
# Set TRANSLATE_API_URL to a public or self-hosted LibreTranslate endpoint, e.g.
#   https://translate.example.com/translate
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# --- Fayda National ID (Ethiopia NIDP / eKYC). Blank = dev auto-approve. ---
FAYDA_API_URL=
FAYDA_API_KEY=


