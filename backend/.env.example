DATABASE_URL=postgres://zega:zega_dev_2026@localhost:5432/zega_alert
PORT=5000
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
APP_NAME=ZEGA-ALERT
PUBLIC_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Encryption at rest (AES-256-GCM) ---
# 64 hex chars (32 bytes) or any passphrase (hashed to 32 bytes).
# Used to encrypt selected PII columns (missing person contact_phone, SOS address_text).
ENCRYPTION_KEY=

# --- Africa's Talking SMS (required for real phone delivery in production) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Demo-only: allow an undelivered OTP to be shown in the app.
OTP_SCREEN_FALLBACK=false

# --- Supabase (optional hosted Postgres). Takes precedence over DATABASE_URL. ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# --- Firebase (optional). Enables Firestore mirror, Cloud Storage uploads and FCM push. ---
# Paste the service-account JSON (single line) or a path to the .json file.
# On hosts that inject env vars, use FIREBASE_SERVICE_ACCOUNT_JSON with the raw JSON.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=
FCM_PROJECT_ID=

# --- Translation engine (on-demand + announcement pre-translation). ---
# Provider selection (auto-detected if not set):
#   TRANSLATE_PROVIDER=google   -> Google Cloud Translation API v2 (key-based)
#   TRANSLATE_PROVIDER=libre    -> LibreTranslate-style POST endpoint (default if URL set)
#   unset / blank               -> placeholder mode ([Lang] original)
#
# Google Cloud Translation API v2 (recommended for the on-demand feature):
#   1. Enable "Cloud Translation API" in your GCP project.
#   2. Create an API key (APIs & Services -> Credentials -> Create credentials -> API key).
#   3. Set TRANSLATE_PROVIDER=google and TRANSLATE_API_KEY=<your key> (GOOGLE_TRANSLATE_API_KEY is also accepted).
#   Leave TRANSLATE_API_URL blank for Google (the service knows the endpoint).
TRANSLATE_PROVIDER=
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# --- Fayda National ID (Ethiopia NIDP / eKYC). Blank = dev auto-approve. ---
FAYDA_API_URL=
FAYDA_API_KEY=


