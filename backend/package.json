{
  "name": "zega-alert-backend",
  "version": "1.0.0",
  "description": "ZEGA-ALERT backend - Crime Reporting, Missing Person Finder & Emergency Assistance API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:deploy": "node scripts/deploy-migrate.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node scripts/run-sql.js schema.sql",
    "db:migrate": "node scripts/run-sql.js migration_gaps.sql",
    "db:seed": "node scripts/run-sql.js seed.sql"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  }
}
