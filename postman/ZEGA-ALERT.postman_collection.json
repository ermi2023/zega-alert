{
  "info": {
    "name": "ZEGA-ALERT API",
    "description": "Crime Reporting, Missing Person Finder and Emergency Assistance System. Base URL: {{baseUrl}}. Login first to populate {{accessToken}} / {{refreshToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }, "auth": { "type": "noauth" } }
        },
        {
          "name": "GET / (root)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }, "auth": { "type": "noauth" } }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"0911000099\",\n  \"fullName\": \"Test Citizen\",\n  \"pin\": \"123456\",\n  \"region\": \"Addis Ababa\",\n  \"subCity\": \"Arada\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "auth": { "type": "noauth" }
        },
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d && d.data) {",
                  "  if (d.data.accessToken) pm.environment.set('accessToken', d.data.accessToken);",
                  "  if (d.data.refreshToken) pm.environment.set('refreshToken', d.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"0911000001\",\n  \"pin\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "auth": { "type": "noauth" }
        },
        {
          "name": "POST /api/auth/refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          },
          "auth": { "type": "noauth" }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] } }
        },
        {
          "name": "PUT /api/auth/me",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"region\": \"Dire Dawa\",\n  \"subCity\": \"Dire Dawa City\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "PUT /api/auth/change-password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPin\": \"password123\",\n  \"newPin\": \"password1234\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "change-password"] }
          }
        },
        {
          "name": "GET /api/auth/staff?q=",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/auth/staff?q=09", "host": ["{{baseUrl}}"], "path": ["api", "auth", "staff"], "query": [{ "key": "q", "value": "09" }] } }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "POST /api/reports",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"crimeType\": \"theft\",\n  \"description\": \"Phone stolen near the market\",\n  \"latitude\": 9.03,\n  \"longitude\": 38.74,\n  \"region\": \"Addis Ababa\",\n  \"subCity\": \"Arada\",\n  \"isAnonymous\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] }
          }
        },
        { "name": "GET /api/reports/mine", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/reports/mine", "host": ["{{baseUrl}}"], "path": ["api", "reports", "mine"] } } },
        { "name": "GET /api/reports", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] } } },
        { "name": "GET /api/reports/:id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}"] } } },
        { "name": "GET /api/reports/:id/history", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/history", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "history"] } } },
        {
          "name": "PATCH /api/reports/:id/status (assign)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"assigned\",\n  \"assigned_to\": \"<officer-uuid>\",\n  \"response_notes\": \"Unit dispatched\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "status"] }
          }
        }
      ]
    },
